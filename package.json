{
  "name": "@brafols/ui",
  "version": "1.1.0",
  "description": "brafols design-system base: React Aria Components + tailwind-variants on Tailwind CSS v4, themed through CSS-variable tokens. Apps override tokens for their own look.",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "import": "./dist/recipes.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "bin": {
    "brafols-ui-check-tokens": "scripts/check-tokens.mjs"
  },
  "files": [
    "dist",
    "scripts/check-tokens.mjs"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsup && tailwindcss -i src/styles.css -o dist/styles.css --minify && node scripts/build-manifest.mjs",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "metadata:check": "node scripts/metadata.mjs check",
    "metadata:stale": "node scripts/metadata.mjs stale",
    "metadata:inputs": "node scripts/metadata.mjs inputs",
    "metadata:stamp": "node scripts/metadata.mjs stamp",
    "lint:tokens": "node scripts/check-tokens.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react-aria-components": "1.21.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borjarafols-dev/ui.git"
  }
}
